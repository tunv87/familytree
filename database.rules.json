{
  "rules": {
    ".read": false,
    ".write": false,
    "families": {
      "$fid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (data.child('admins').child(auth.uid).exists() || (!data.exists() && newData.child('admins').child(auth.uid).val() === true && newData.child('meta/owner').val() === auth.uid))",
        ".validate": "$fid.matches(/^[A-Za-z0-9]{20}$/) && newData.hasChildren(['meta', 'admins']) && newData.child('admins').child(newData.child('meta/owner').val() + '').val() === true",
        "meta": {
          ".validate": "newData.hasChildren(['name', 'owner', 'createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "owner": {
            ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "topGeneration": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 60"
          },
          "$other": { ".validate": false }
        },
        "admins": {
          "$uid": { ".validate": "newData.val() === true" }
        },
        "people": {
          "$pid": {
            ".validate": "$pid.matches(/^[A-Za-z0-9]{8,24}$/) && newData.hasChildren(['name', 'gender'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "gender": {
              ".validate": "newData.val() === 'm' || newData.val() === 'f' || newData.val() === 'u'"
            },
            "generation": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60"
            },
            "deceased": { ".validate": "newData.isBoolean()" },
            "birth": {
              ".validate": "newData.hasChild('cal')",
              "cal": { ".validate": "newData.val() === 's' || newData.val() === 'l'" },
              "y": { ".validate": "newData.isNumber()" },
              "m": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
              },
              "d": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31"
              },
              "leap": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            },
            "death": {
              ".validate": "newData.hasChild('cal')",
              "cal": { ".validate": "newData.val() === 's' || newData.val() === 'l'" },
              "y": { ".validate": "newData.isNumber()" },
              "m": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
              },
              "d": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31"
              },
              "leap": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            },
            "fatherId": { ".validate": "newData.isString()" },
            "motherId": { ".validate": "newData.isString()" },
            "spouses": {
              "$sid": { ".validate": "newData.val() === true" }
            },
            "order": { ".validate": "newData.isNumber()" },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com'",
        "families": {
          "$fid": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
